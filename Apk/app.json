{
  "expo": {
    "name": "Abacus",
    "slug": "abacus",
    "version": "1.1.1",
    "icon": "./assets/Sin título-2.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*",
      "Logos/**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "7bb4fcc1-72bc-4152-b249-a7f1aa7426e4"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "package": "com.agust9999.Abacus"
          }
        }
      ]
    ],
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.agust9999.Abacus"
    }
  }
}
